---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('writing')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Writing | Musa Ibrahim"
  description="Writing by Musa Ibrahim on HealthTech, FinTech UX, frontend engineering, marketplace workflows, civic tech, and AI-assisted software development."
  htmlClass="article-page"
  bodyClass="article-page"
>
  <header class="subpage-header">
    <div class="container subpage-nav">
      <a href="/">&larr; Back to portfolio</a>
      <a href="mailto:musabish98@gmail.com?subject=Writing%20and%20Frontend%20Work">Discuss an article</a>
    </div>
  </header>
  <main class="container">
    <section class="article-hero writing-index-hero">
      <p class="eyebrow">Writing</p>
      <h1>Notes on frontend engineering, product trust, and workflow software.</h1>
      <p>These articles connect my project work to the product problems I want to keep solving: pharmacy digitization, escrow confidence, rental flows, civic reporting, accessibility, and framework decisions.</p>
    </section>

    <section class="section writing-index-section">
      <div class="section-heading">
        <p class="eyebrow">Published notes</p>
        <h2>Writing shaped by the projects I build</h2>
        <p>Each article connects a product problem to the interface decisions that make software clearer, safer, or easier to trust.</p>
      </div>
      <div class="writing-grid writing-grid-large writing-index-grid">
        {articles.map((article) => (
          <article class="writing-card">
            <a class="writing-media" href={`/writing/${article.id}`} aria-label={`Read ${article.data.title}`}>
              <img src={article.data.image} alt={article.data.alt} loading={article.data.order <= 2 ? 'eager' : 'lazy'} decoding="async" width="640" height="420">
            </a>
            <p class="writing-type">{article.data.type}</p>
            <h2><a href={`/writing/${article.id}`}>{article.data.title}</a></h2>
            <p>{article.data.description}</p>
            <span class="read-time">{article.data.readTime}</span>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
