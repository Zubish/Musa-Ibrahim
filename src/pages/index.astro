---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const articles = (await getCollection('writing')).sort((a, b) => a.data.order - b.data.order);
const featuredProject = projects.find((project) => project.data.featured) ?? projects[0];

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Musa Ibrahim',
  jobTitle: 'Frontend Developer Intern',
  url: 'https://musa-ibrahim-lac.vercel.app/',
  sameAs: [
    'https://github.com/Zubish',
    'https://www.linkedin.com/in/realvjy',
    'https://x.com/goastwriterspen?t=9sXImSmsilFYY_x90LNbrQ&s=09'
  ]
};
---
<BaseLayout>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(personJsonLd)}></script>
  <SiteHeader />

  <main id="main-content">
    <section id="top" class="hero">
      <div class="hero-backdrop" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy reveal">
          <p class="eyebrow">Frontend intern / HealthTech builder</p>
          <h1>I build workflow-heavy web apps that turn product rules into usable screens.</h1>
          <p class="hero-summary">I am looking for frontend, software engineering, and product-focused internships where I can contribute to shipped interfaces. My work combines React, TypeScript, Next.js, Astro, accessibility-minded UI, AI-assisted development, and pharmacy operations context.</p>
          <div class="hero-cta-row">
            <a class="button button-primary" href="#work">Explore my work</a>
            <a class="button button-secondary" href="#contact">Start a conversation</a>
            <a class="button button-ghost" href="mailto:musabish98@gmail.com?subject=Resume%20Request">Request my resume</a>
          </div>
          <ul class="hero-highlights">
            <li>Frontend internship-ready case studies</li>
            <li>React, TypeScript, Next.js, Astro, and Vite</li>
            <li>Prompt engineering for product and code workflows</li>
          </ul>
        </div>

        <aside class="hero-panel reveal">
          <div class="hero-card hero-card-profile">
            <img src="/img/Professional%20photo%20me.jpg" alt="Portrait of Musa Ibrahim" class="profile-photo" loading="eager" decoding="async" width="220" height="220">
            <div>
              <p class="card-label">Currently focused on</p>
              <p class="card-strong">Frontend internships, HealthTech tools, trusted marketplaces, and product interfaces with real user roles.</p>
            </div>
          </div>
          <div class="hero-card hero-card-metric">
            <p class="card-label">Inside this portfolio</p>
            <div class="metric-grid">
              <div>
                <span class="metric-number">{projects.length}</span>
                <span class="metric-label">case studies</span>
              </div>
              <div>
                <span class="metric-number">{articles.length}</span>
                <span class="metric-label">working notes</span>
              </div>
              <div>
                <span class="metric-number">{projects.length}</span>
                <span class="metric-label">live project links</span>
              </div>
              <div>
                <span class="metric-number">Intern</span>
                <span class="metric-label">positioning</span>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="featured-band reveal">
      <div class="container featured-band-inner">
        <p class="featured-band-title">Featured HealthTech case study</p>
        <p class="featured-band-copy">RxLedger shows the clearest match between my pharmacy background and frontend engineering: branch inventory, FEFO expiry control, POS flow, staff permissions, and audit-ready records.</p>
      </div>
    </section>

    <section id="work" class="section container reveal">
      <div class="section-heading">
        <p class="eyebrow">Selected work</p>
        <h2>Four deployed projects built around workflows recruiters can inspect</h2>
        <p>RxLedger, BlackCrow, i-Go-rent, and VisionEcho show how I handle inventory, escrow, rental booking, verification, role-based dashboards, and mobile-first product flows.</p>
      </div>

      {featuredProject && (
        <article class="featured-project">
          <button
            class="featured-project-media image-modal-trigger"
            type="button"
            data-modal-image={featuredProject.data.image}
            data-modal-alt={featuredProject.data.alt}
            aria-label={`Open ${featuredProject.data.title} screenshot`}
          >
            <img src={featuredProject.data.image} alt={featuredProject.data.alt} loading="lazy" decoding="async" width="900" height="620">
          </button>
          <div class="featured-project-copy">
            <p class="eyebrow">{featuredProject.data.eyebrow}</p>
            <h3>{featuredProject.data.title}</h3>
            <p>{featuredProject.data.description}</p>
            <ul class="tag-list">
              {featuredProject.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            <div class="action-row">
              <a class="project-cta-link" href={`/projects/${featuredProject.id}`}>Read case study</a>
            </div>
          </div>
        </article>
      )}

      <div class="projects-grid">
        {projects.map((project) => (
          <article class="project-card">
            <button
              class="project-thumbnail-button image-modal-trigger"
              type="button"
              data-modal-image={project.data.image}
              data-modal-alt={project.data.alt}
              aria-label={`Open ${project.data.title} screenshot`}
            >
              <img class="project-thumbnail" src={project.data.image} alt={project.data.alt} loading="lazy" decoding="async" width="640" height="420">
            </button>
            <div class="project-card-body">
              <p class="project-type">{project.data.type}</p>
              <h3>{project.data.title}</h3>
              <p>{project.data.cardDescription}</p>
              <ul class="tag-list">
                {project.data.cardTags.map((tag) => <li>{tag}</li>)}
              </ul>
              <div class="card-links">
                <a class="project-cta-link" href={`/projects/${project.id}`}>Read case study</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="about" class="section container reveal">
      <div class="split-panel">
        <div>
          <p class="eyebrow">About me</p>
          <h2>I bring software engineering training and pharmacy operations context into product work.</h2>
          <p>I am currently in 400-level Software Engineering at Miva Open University, and I am positioning for frontend and software engineering internship roles. I want recruiters to see a frontend intern who can reason through product flows, write frontend code, test CTAs, and explain design decisions through user pain points.</p>
          <p>As a Pharmacy Technician, I notice operational details many junior builders miss: expiry pressure, branch stock visibility, staff handover, payment confidence, identity checks, and the small interface decisions that can slow down real work. I use AI as a coding assistant and prompt engineering partner to move faster, compare ideas, and refine implementation without skipping judgment.</p>
        </div>
        <div class="about-callout">
          <p class="callout-title">Positioning headline</p>
          <p>Frontend developer intern focused on HealthTech, trusted marketplaces, workflow UX, and role-aware product interfaces.</p>
          <p class="callout-title">Currently open to</p>
          <p>Frontend internships, software engineering internships, HealthTech collaborations, and product teams that value domain-aware builders.</p>
        </div>
      </div>
    </section>

    <section id="skills" class="section container reveal">
      <div class="section-heading">
        <p class="eyebrow">Skills and tools</p>
        <h2>The stack I use to turn product requirements into usable screens</h2>
      </div>
      <div class="skills-grid">
        <article class="info-card">
          <h3>Front-end implementation</h3>
          <ul class="plain-list">
            <li>Semantic HTML</li>
            <li>Responsive CSS layouts</li>
            <li>React, TypeScript, and Next.js</li>
            <li>Astro, Vite, and deployable static pages</li>
          </ul>
        </article>
        <article class="info-card">
          <h3>Product and domain thinking</h3>
          <ul class="plain-list">
            <li>Pharmacy workflow mapping</li>
            <li>Inventory, escrow, and verification flows</li>
            <li>Role-aware user journeys</li>
            <li>Operational dashboard planning</li>
          </ul>
        </article>
        <article class="info-card">
          <h3>AI-assisted workflow</h3>
          <ul class="plain-list">
            <li>Prompt engineering</li>
            <li>AI-assisted code iteration</li>
            <li>CTA, copy, and interface critique</li>
            <li>Testing ideas against real user flows</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="section container reveal">
      <div class="section-heading">
        <p class="eyebrow">What I bring</p>
        <h2>Why this portfolio should matter to recruiters</h2>
      </div>
      <div class="trust-grid">
        <article class="info-card">
          <h3>Domain awareness</h3>
          <p>RxLedger proves I can connect a real domain to product screens: pharmacy stock, expiry risk, POS handoff, staff permissions, and branch-level reporting.</p>
        </article>
        <article class="info-card">
          <h3>Internship-ready proof</h3>
          <p>Each project links to a live deployment and GitHub repository, so recruiters can inspect the interface, code direction, routing, and implementation scope.</p>
        </article>
        <article class="info-card">
          <h3>AI-assisted execution</h3>
          <p>I use prompt engineering to clarify requirements, compare product flows, review edge cases, and turn rough ideas into testable frontend builds.</p>
        </article>
      </div>
    </section>

    <section class="section container reveal" aria-labelledby="testimonials-title">
      <div class="section-heading">
        <p class="eyebrow">Collaboration fit</p>
        <h2 id="testimonials-title">How I would contribute as an intern</h2>
        <p>I work best where the interface has a real job: a user needs to book, verify, pay, report, dispense, review, or hand something off without guessing.</p>
      </div>
      <div class="testimonials-grid">
        <article class="quote-card">
          <h3>Clear product reasoning</h3>
          <p>I explain interface decisions through user tasks: what a pharmacist, cashier, buyer, seller, renter, vendor, reporter, editor, or recruiter needs to understand next.</p>
        </article>
        <article class="quote-card">
          <h3>Fast, careful iteration</h3>
          <p>I use AI to move quickly through options, then slow down on the parts that need human judgment: wording, hierarchy, edge cases, mobile behavior, accessibility, and CTA clarity.</p>
        </article>
      </div>
    </section>

    <section id="process" class="section container reveal">
      <div class="section-heading">
        <p class="eyebrow">How I work</p>
        <h2>My process starts with the workflow, then moves into the interface</h2>
      </div>
      <div class="process-grid">
        <article class="process-step">
          <span class="step-number">01</span>
          <h3>Map the real task</h3>
          <p>I identify the roles, data, risks, and repeated actions first, whether the product is handling stock, escrow funds, civic reports, or recruiter review.</p>
        </article>
        <article class="process-step">
          <span class="step-number">02</span>
          <h3>Prompt, compare, build</h3>
          <p>I use prompt engineering to explore flows and implementation paths, then translate the strongest direction into responsive front-end screens.</p>
        </article>
        <article class="process-step">
          <span class="step-number">03</span>
          <h3>Test the handoff points</h3>
          <p>I check the moments where users can get confused: state changes, empty data, mobile stacking, form errors, next actions, and links to the live product or repo.</p>
        </article>
      </div>
    </section>

    <section id="writing" class="section container reveal">
      <div class="section-heading">
        <p class="eyebrow">Writing</p>
        <h2>Engineering notes around the domains I build for</h2>
        <p>Short essays on HealthTech, escrow UX, marketplace state design, civic reporting, and the frontend decisions behind trustworthy software.</p>
      </div>
      <div class="writing-grid">
        {articles.slice(0, 3).map((article) => (
          <article class="writing-card">
            <a class="writing-media" href={`/writing/${article.id}`} aria-label={`Read ${article.data.title}`}>
              <img src={article.data.image} alt={article.data.alt} loading="lazy" decoding="async" width="640" height="420">
            </a>
            <p class="writing-type">{article.data.type}</p>
            <h3><a href={`/writing/${article.id}`}>{article.data.title}</a></h3>
            <p>{article.data.description}</p>
            <span class="read-time">{article.data.readTime}</span>
          </article>
        ))}
      </div>
      <div class="section-action">
        <a class="project-cta-link" href="/writing/">See more writing</a>
      </div>
    </section>

    <section id="contact" class="section container reveal">
      <div class="contact-shell">
        <div class="contact-copy">
          <p class="eyebrow">Contact</p>
          <h2>Have a frontend internship, HealthTech, or product workflow opportunity?</h2>
          <p>I'm open to frontend internships, software engineering internships, HealthTech collaborations, and product teams where my pharmacy background and AI-assisted workflow can be useful.</p>
          <div class="contact-links">
            <a href="mailto:musabish98@gmail.com">musabish98@gmail.com</a>
            <a href="https://github.com/Zubish" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="https://www.linkedin.com/in/realvjy" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a href="https://x.com/goastwriterspen?t=9sXImSmsilFYY_x90LNbrQ&s=09" target="_blank" rel="noopener noreferrer">X</a>
          </div>
        </div>

        <div class="contact-form-card">
          <div id="contact-status" class="contact-status" aria-live="polite"></div>
          <form id="contact-form" novalidate>
            <label for="contact-name">Name</label>
            <input id="contact-name" name="name" type="text" required aria-required="true" autocomplete="name">
            <p class="field-error" id="contact-name-error"></p>

            <label for="contact-email">Email</label>
            <input id="contact-email" name="email" type="email" required aria-required="true" autocomplete="email">
            <p class="field-error" id="contact-email-error"></p>

            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="message" rows="5" required aria-required="true"></textarea>
            <p class="field-error" id="contact-message-error"></p>

            <button type="submit" class="button button-primary">Open email draft</button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
