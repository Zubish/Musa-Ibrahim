---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const articles = (await getCollection('writing')).sort((a, b) => a.data.order - b.data.order);
const featuredProject = projects.find((project) => project.data.featured) ?? projects[0];
const landingProjects = projects.filter((project) => project.id !== featuredProject?.id).slice(0, 2);
const landingArticles = articles.slice(0, 2);

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Musa Ibrahim',
  jobTitle: 'HealthTech Software Builder',
  url: 'https://musa-ibrahim-lac.vercel.app/',
  sameAs: [
    'https://github.com/Zubish',
    'https://www.linkedin.com/in/musaibrahimamanosi',
    'https://x.com/goastwriterspen?t=9sXImSmsilFYY_x90LNbrQ&s=09'
  ]
};
---
<BaseLayout>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(personJsonLd)}></script>
  <SiteHeader />

  <main id="main-content">
    <section id="top" class="hero">
      <div class="hero-backdrop" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy reveal">
          <p class="eyebrow">AI web development / HealthTech / Frontend</p>
          <h1>Building software people can rely on.</h1>
          <p class="hero-summary">Hi, I'm Musa Ibrahim.</p>
          <p class="hero-summary">I build web applications that simplify healthcare operations, improve business workflows, and solve real-world problems through thoughtful design and engineering.</p>
          <p class="hero-summary">My background in pharmacy and software engineering gives me a unique perspective on building systems that are not only functional, but practical for the people who use them every day.</p>
          <p class="hero-summary">Currently focused on AI-powered development, HealthTech products, and modern frontend engineering.</p>
          <div class="hero-cta-row">
            <a class="button button-primary" href="#work">Explore my work</a>
            <a class="button button-secondary" href="#contact">Start a conversation</a>
            <a class="button button-ghost" href="mailto:musabish98@gmail.com?subject=Resume%20Request">Request my resume</a>
          </div>
          <ul class="hero-highlights">
            <li>HealthTech products shaped by real pharmacy workflow experience</li>
            <li>Business tools for inventory, reporting, trust, and operations</li>
            <li>AI-assisted development guided by practical product judgment</li>
          </ul>
        </div>

        <aside class="hero-panel reveal">
          <div class="hero-card hero-card-profile">
            <img src="/img/Professional%20photo%20me.jpg" alt="Portrait of Musa Ibrahim" class="profile-photo" loading="eager" decoding="async" width="220" height="220">
            <div>
              <p class="card-label">What I bring into the role</p>
              <p class="card-strong">Software work grounded in practical product judgment: pharmacy operations, payment trust, booking flows, and reporting tools.</p>
            </div>
          </div>
          <div class="hero-card hero-card-metric">
            <p class="card-label">Inside this portfolio</p>
            <div class="metric-grid">
              <div>
                <span class="metric-number">{projects.length}</span>
                <span class="metric-label">case studies</span>
              </div>
              <div>
                <span class="metric-number">{articles.length}</span>
                <span class="metric-label">working notes</span>
              </div>
              <div>
                <span class="metric-number">{projects.length}</span>
                <span class="metric-label">live project links</span>
              </div>
              <div>
                <span class="metric-number">Student</span>
                <span class="metric-label">software engineering</span>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="featured-band reveal" aria-label="Short introduction">
      <div class="container featured-band-inner intro-band-inner">
        <p class="featured-band-copy">From pharmacy inventory systems to escrow platforms and business management tools, I enjoy turning complex processes into software that feels simple to use.</p>
        <p class="featured-band-copy">I believe great software should do more than look good &mdash; it should help people work faster, make better decisions, and trust the systems they depend on.</p>
      </div>
    </section>

    <section id="work" class="section container reveal">
      <div class="section-heading">
        <p class="eyebrow">Work</p>
        <h2>Selected Projects</h2>
        <p>These projects reflect my interest in solving operational challenges through software &mdash; from healthcare and inventory management to trust, transparency, and business efficiency.</p>
        <p>Each project started with a real problem and was designed around the people expected to use it.</p>
      </div>

      {featuredProject && (
        <article class="featured-project">
          <button
            class="featured-project-media image-modal-trigger"
            type="button"
            data-modal-image={featuredProject.data.image}
            data-modal-alt={featuredProject.data.alt}
            aria-label={`Open ${featuredProject.data.title} screenshot`}
          >
            <img src={featuredProject.data.image} alt={featuredProject.data.alt} loading="lazy" decoding="async" width="900" height="620">
          </button>
          <div class="featured-project-copy">
            <p class="eyebrow">{featuredProject.data.eyebrow}</p>
            <h3>{featuredProject.data.title}</h3>
            <p>{featuredProject.data.description}</p>
            <ul class="tag-list">
              {featuredProject.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            <div class="action-row">
              <a class="project-cta-link" href={`/projects/${featuredProject.id}`}>Read case study</a>
            </div>
          </div>
        </article>
      )}

      <div class="projects-grid landing-projects-grid">
        {landingProjects.map((project) => (
          <article class="project-card landing-project-card">
            <button
              class="project-thumbnail-button image-modal-trigger"
              type="button"
              data-modal-image={project.data.image}
              data-modal-alt={project.data.alt}
              aria-label={`Open ${project.data.title} screenshot`}
            >
              <img class="project-thumbnail" src={project.data.image} alt={project.data.alt} loading="lazy" decoding="async" width="640" height="420">
            </button>
            <div class="project-card-body">
              <p class="project-type">{project.data.type}</p>
              <h3>{project.data.title}</h3>
              <p>{project.data.cardDescription}</p>
              <ul class="tag-list">
                {project.data.cardTags.map((tag) => <li>{tag}</li>)}
              </ul>
              <div class="card-links">
                <a class="project-cta-link" href={`/projects/${project.id}`}>Read case study</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="about" class="section container reveal">
      <div class="split-panel">
        <div>
          <p class="eyebrow">About me</p>
          <h2>My Story</h2>
          <p>Before writing code professionally, I worked within healthcare environments where accuracy, efficiency, and accountability directly affected patient outcomes.</p>
          <p>I saw how disconnected systems, manual processes, and poor software experiences created unnecessary challenges for healthcare professionals and businesses alike.</p>
          <p>That experience shaped how I approach software development today.</p>
          <p>When I build a product, I focus on the workflow behind the interface. Every button, notification, dashboard, and report should serve a clear purpose.</p>
          <p>Whether I'm building a pharmacy management platform like RxLedger or experimenting with new AI-powered workflows, my goal remains the same:</p>
          <p><strong>Build technology that solves problems people actually have.</strong></p>
        </div>
        <div class="about-callout">
          <p class="callout-title">Background</p>
          <p>Software Engineering student, Certified Pharmacy Technician, and builder focused on products where trust, workflow, and usability matter.</p>
          <p class="callout-title">Current focus</p>
          <p>AI-powered development, HealthTech products, and modern frontend engineering.</p>
        </div>
      </div>
    </section>

    <section id="skills" class="section container reveal">
      <div class="section-heading">
        <p class="eyebrow">Services</p>
        <h2>What I Build</h2>
      </div>
      <div class="skills-grid">
        <article class="info-card">
          <h3>HealthTech Solutions</h3>
          <ul class="plain-list">
            <li>Pharmacy systems</li>
            <li>Inventory management</li>
            <li>Workflow automation</li>
            <li>Patient-focused platforms</li>
          </ul>
        </article>
        <article class="info-card">
          <h3>Business Applications</h3>
          <ul class="plain-list">
            <li>Dashboards</li>
            <li>Reporting systems</li>
            <li>Administrative tools</li>
            <li>Operations management software</li>
          </ul>
        </article>
        <article class="info-card">
          <h3>Modern Web Experiences</h3>
          <ul class="plain-list">
            <li>Responsive web applications</li>
            <li>AI-assisted products</li>
            <li>SaaS interfaces</li>
            <li>Product landing pages</li>
          </ul>
        </article>
      </div>
    </section>

    <section id="currently-building" class="section container reveal">
      <div class="section-heading">
        <p class="eyebrow">In progress</p>
        <h2>Currently Building</h2>
      </div>
      <div class="trust-grid">
        <article class="info-card">
          <h3>RxLedger</h3>
          <p>Community Pharmacy Management Platform</p>
        </article>
        <article class="info-card">
          <h3>AI-assisted healthcare workflows</h3>
          <p>Exploring ways AI can support clearer healthcare operations without removing human judgment.</p>
        </article>
        <article class="info-card">
          <h3>Business operations software</h3>
          <p>Dashboards, records, and admin tools for teams that need cleaner day-to-day workflows.</p>
        </article>
        <article class="info-card">
          <h3>Open-source tools and experiments</h3>
          <p>Small experiments around AI development, interface ideas, and practical product workflows.</p>
        </article>
      </div>
    </section>

    <section class="section container reveal" aria-labelledby="testimonials-title">
      <div class="section-heading">
        <p class="eyebrow">Collaboration fit</p>
        <h2 id="testimonials-title">How I work with product teams</h2>
        <p>I am useful on teams that need someone who asks practical questions before touching the UI. What is the user trying to do? What can go wrong? What should they see next?</p>
      </div>
      <div class="testimonials-grid">
        <article class="quote-card">
          <h3>I care about the user task</h3>
          <p>A pharmacist, cashier, buyer, seller, renter, reporter, editor, or recruiter should not have to guess their next step because the interface wants to look clever.</p>
        </article>
        <article class="quote-card">
          <h3>I move fast, then check properly</h3>
          <p>I use AI to explore options quickly, then slow down on the parts that need human judgment: wording, hierarchy, edge cases, mobile behavior, accessibility, and CTA clarity.</p>
        </article>
      </div>
    </section>

    <section id="process" class="section container reveal">
      <div class="section-heading">
        <p class="eyebrow">How I work</p>
        <h2>I start with what the user is really trying to do</h2>
      </div>
      <div class="process-grid">
        <article class="process-step">
          <span class="step-number">01</span>
          <h3>Understand the task</h3>
          <p>I identify the roles, data, risks, and repeated actions first. Stock control, escrow funds, civic reports, and recruiter review all break down when the next step is unclear.</p>
        </article>
        <article class="process-step">
          <span class="step-number">02</span>
          <h3>Use AI, then choose like a human</h3>
          <p>I use prompt engineering to explore flows and implementation paths, then choose the direction that best fits the product instead of accepting the first polished answer.</p>
        </article>
        <article class="process-step">
          <span class="step-number">03</span>
          <h3>Check what people actually click</h3>
          <p>I test the moments where users can get confused: state changes, empty data, mobile stacking, form errors, next actions, and links to the live product or repo.</p>
        </article>
      </div>
    </section>

    <section id="writing" class="section container reveal">
      <div class="section-heading">
        <p class="eyebrow">Writing</p>
        <h2>Notes from the projects I am building</h2>
        <p>Short essays on HealthTech, escrow UX, marketplace state design, civic reporting, and the frontend decisions that make software feel trustworthy, not just polished.</p>
      </div>
      <div class="writing-grid landing-writing-grid">
        {landingArticles.map((article) => (
          <article class="writing-card">
            <a class="writing-media" href={`/writing/${article.id}`} aria-label={`Read ${article.data.title}`}>
              <img src={article.data.image} alt={article.data.alt} loading="lazy" decoding="async" width="640" height="420">
            </a>
            <p class="writing-type">{article.data.type}</p>
            <h3><a href={`/writing/${article.id}`}>{article.data.title}</a></h3>
            <p>{article.data.description}</p>
            <span class="read-time">{article.data.readTime}</span>
          </article>
        ))}
      </div>
      <div class="section-action">
        <a class="project-cta-link" href="/writing/">See more writing</a>
      </div>
    </section>

    <section id="contact" class="section container reveal">
      <div class="contact-shell">
        <div class="contact-copy">
          <p class="eyebrow">Contact</p>
          <h2>Let's build something useful.</h2>
          <p>I'm open to frontend internships, software engineering opportunities, HealthTech collaborations, and product teams working on real operational problems.</p>
          <p>If you need someone who can think beyond the UI, understand the workflow, and build interfaces that are both clean and functional, I'd be happy to connect.</p>
          <p class="contact-closing">Frontend Developer &bull; AI Web Development &bull; HealthTech Builder</p>
          <div class="contact-links">
            <a href="mailto:musabish98@gmail.com">musabish98@gmail.com</a>
            <a href="https://github.com/Zubish" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="https://www.linkedin.com/in/musaibrahimamanosi" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a href="https://x.com/goastwriterspen?t=9sXImSmsilFYY_x90LNbrQ&s=09" target="_blank" rel="noopener noreferrer">X</a>
          </div>
        </div>

        <div class="contact-form-card">
          <div id="contact-status" class="contact-status" aria-live="polite"></div>
          <form id="contact-form" novalidate>
            <label for="contact-name">Name</label>
            <input id="contact-name" name="name" type="text" required aria-required="true" autocomplete="name">
            <p class="field-error" id="contact-name-error"></p>

            <label for="contact-email">Email</label>
            <input id="contact-email" name="email" type="email" required aria-required="true" autocomplete="email">
            <p class="field-error" id="contact-email-error"></p>

            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="message" rows="5" required aria-required="true"></textarea>
            <p class="field-error" id="contact-message-error"></p>

            <button type="submit" class="button button-primary">Open email draft</button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
