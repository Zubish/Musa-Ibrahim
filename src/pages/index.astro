---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const articles = (await getCollection('writing')).sort((a, b) => a.data.order - b.data.order);
const featuredProject = projects.find((project) => project.data.featured) ?? projects[0];

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Musa Ibrahim',
  jobTitle: 'Front-end Developer',
  url: 'https://musa-ibrahim-lac.vercel.app/',
  sameAs: [
    'https://github.com/Zubish',
    'https://x.com/goastwriterspen?t=9sXImSmsilFYY_x90LNbrQ&s=09'
  ]
};
---
<BaseLayout>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(personJsonLd)}></script>
  <SiteHeader />

  <main id="main-content">
    <section id="top" class="hero">
      <div class="hero-backdrop" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy reveal">
          <p class="eyebrow">Front-end developer / Available for freelance, collaborations, and internships</p>
          <h1>I design and build interfaces that feel polished, clear, and easy to use.</h1>
          <p class="hero-summary">I focus on responsive front-end work, thoughtful UI decisions, and accessible experiences that help brands and products feel more credible from the first scroll.</p>
          <div class="hero-cta-row">
            <a class="button button-primary" href="#work">Explore my work</a>
            <a class="button button-secondary" href="#contact">Start a conversation</a>
            <a class="button button-ghost" href="mailto:musabish98@gmail.com?subject=Resume%20Request">Request my resume</a>
          </div>
          <ul class="hero-highlights">
            <li>Accessible front-end interfaces</li>
            <li>Responsive layouts across devices</li>
            <li>Clean visual systems and interaction polish</li>
          </ul>
        </div>

        <aside class="hero-panel reveal">
          <div class="hero-card hero-card-profile">
            <img src="/img/Professional%20photo%20me.jpg" alt="Portrait of Musa Ibrahim" class="profile-photo" loading="eager" decoding="async" width="220" height="220">
            <div>
              <p class="card-label">Currently focused on</p>
              <p class="card-strong">Portfolio sites, product landing pages, and user-first front-end builds.</p>
            </div>
          </div>
          <div class="hero-card hero-card-metric">
            <p class="card-label">Inside this portfolio</p>
            <div class="metric-grid">
              <div>
                <span class="metric-number">{projects.length}</span>
                <span class="metric-label">case studies</span>
              </div>
              <div>
                <span class="metric-number">{articles.length}</span>
                <span class="metric-label">writing pieces</span>
              </div>
              <div>
                <span class="metric-number">{featuredProject ? 1 : 0}</span>
                <span class="metric-label">featured project</span>
              </div>
              <div>
                <span class="metric-number">100%</span>
                <span class="metric-label">static deployable</span>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="featured-band reveal">
      <div class="container featured-band-inner">
        <p class="featured-band-title">Featured project</p>
        <p class="featured-band-copy">This featured piece leads with layout decisions, messaging, and front-end execution so the strongest work sets the tone for everything that follows.</p>
      </div>
    </section>

    <section id="work" class="section container reveal">
      <div class="section-heading">
        <p class="eyebrow">Selected work</p>
        <h2>Projects that show both design taste and front-end execution</h2>
        <p>Each project is framed around the thinking behind the interface, not just a screenshot, so the work reads as considered and intentional.</p>
      </div>

      {featuredProject && (
        <article class="featured-project">
          <button
            class="featured-project-media image-modal-trigger"
            type="button"
            data-modal-image={featuredProject.data.image}
            data-modal-alt={featuredProject.data.alt}
            aria-label={`Open ${featuredProject.data.title} screenshot`}
          >
            <img src={featuredProject.data.image} alt={featuredProject.data.alt} loading="lazy" decoding="async" width="900" height="620">
          </button>
          <div class="featured-project-copy">
            <p class="eyebrow">{featuredProject.data.eyebrow}</p>
            <h3>{featuredProject.data.title}</h3>
            <p>{featuredProject.data.description}</p>
            <ul class="tag-list">
              {featuredProject.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            <div class="action-row">
              <a class="button button-primary" href={`/projects/${featuredProject.id}`}>Read case study</a>
            </div>
          </div>
        </article>
      )}

      <div class="projects-grid">
        {projects.map((project) => (
          <article class="project-card">
            <button
              class="project-thumbnail-button image-modal-trigger"
              type="button"
              data-modal-image={project.data.image}
              data-modal-alt={project.data.alt}
              aria-label={`Open ${project.data.title} screenshot`}
            >
              <img class="project-thumbnail" src={project.data.image} alt={project.data.alt} loading="lazy" decoding="async" width="640" height="420">
            </button>
            <div class="project-card-body">
              <p class="project-type">{project.data.type}</p>
              <h3>{project.data.title}</h3>
              <p>{project.data.cardDescription}</p>
              <ul class="tag-list">
                {project.data.cardTags.map((tag) => <li>{tag}</li>)}
              </ul>
              <div class="card-links">
                <a href={`/projects/${project.id}`}>Case study</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="about" class="section container reveal">
      <div class="split-panel">
        <div>
          <p class="eyebrow">About me</p>
          <h2>I care about how a product feels, not just how it looks.</h2>
          <p>I enjoy building interfaces that are visually sharp without becoming noisy. My approach combines clean front-end structure, thoughtful spacing, readable content, and interactions that support the user instead of distracting them.</p>
          <p>I'm drawn to work that needs both design sensitivity and disciplined implementation, especially personal brands, startup landing pages, and product interfaces that need to feel sharper, clearer, and more credible.</p>
        </div>
        <div class="about-callout">
          <p class="callout-title">Positioning headline</p>
          <p>Front-end developer focused on accessible UI, responsive experiences, and polished digital presentation.</p>
          <p class="callout-title">Currently open to</p>
          <p>Freelance projects, internships, portfolio collaborations, and UI-focused front-end work.</p>
        </div>
      </div>
    </section>

    <section id="skills" class="section container reveal">
      <div class="section-heading">
        <p class="eyebrow">Skills and tools</p>
        <h2>The skills I lean on to make interfaces feel cleaner and more effective</h2>
      </div>
      <div class="skills-grid">
        <article class="info-card">
          <h3>Front-end foundations</h3>
          <ul class="plain-list">
            <li>Semantic HTML</li>
            <li>Responsive CSS layouts</li>
            <li>Vanilla JavaScript interactions</li>
            <li>Accessibility-minded structure</li>
          </ul>
        </article>
        <article class="info-card">
          <h3>Design strengths</h3>
          <ul class="plain-list">
            <li>Typography hierarchy</li>
            <li>Spacing systems</li>
            <li>Call-to-action clarity</li>
            <li>Visual consistency</li>
          </ul>
        </article>
        <article class="info-card">
          <h3>Workflow</h3>
          <ul class="plain-list">
            <li>Static site structure</li>
            <li>Content-first page planning</li>
            <li>Mobile and desktop refinement</li>
            <li>Continuous polish and iteration</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="section container reveal">
      <div class="section-heading">
        <p class="eyebrow">Trust signals</p>
        <h2>Built to make it easier to say yes</h2>
      </div>
      <div class="trust-grid">
        <article class="info-card">
          <h3>Direct next step</h3>
          <p>The resume request link gives recruiters and clients a clear action if they want more detail than the homepage provides.</p>
        </article>
        <article class="info-card">
          <h3>Honest framing</h3>
          <p>The project language stays clear about what is concept work and what is production work, which keeps the portfolio credible.</p>
        </article>
        <article class="info-card">
          <h3>Stronger positioning</h3>
          <p>The headline, About section, and featured work all point to the same message: front-end work with design taste, structure, and polish.</p>
        </article>
      </div>
    </section>

    <section class="section container reveal" aria-labelledby="testimonials-title">
      <div class="section-heading">
        <p class="eyebrow">Collaboration fit</p>
        <h2 id="testimonials-title">What clients and teams can expect</h2>
        <p>These are the habits I try to bring into every collaboration, especially when a project needs polish as much as it needs code.</p>
      </div>
      <div class="testimonials-grid">
        <article class="quote-card">
          <h3>Clear communication</h3>
          <p>I keep the goal, content, and user path visible throughout the build so design decisions stay connected to the outcome.</p>
        </article>
        <article class="quote-card">
          <h3>Careful refinement</h3>
          <p>I pay attention to spacing, responsiveness, accessibility, and small interaction details that make an interface feel finished.</p>
        </article>
      </div>
    </section>

    <section id="process" class="section container reveal">
      <div class="section-heading">
        <p class="eyebrow">How I work</p>
        <h2>A working process built around clarity, direction, and polish</h2>
      </div>
      <div class="process-grid">
        <article class="process-step">
          <span class="step-number">01</span>
          <h3>Clarify the goal</h3>
          <p>I start by understanding what the page needs to do, who it serves, and what should stand out first.</p>
        </article>
        <article class="process-step">
          <span class="step-number">02</span>
          <h3>Shape the interface</h3>
          <p>I organize layout, hierarchy, and content so the page feels cleaner and more persuasive before adding polish.</p>
        </article>
        <article class="process-step">
          <span class="step-number">03</span>
          <h3>Refine the experience</h3>
          <p>I tune spacing, responsiveness, accessibility, and interactions so the final result feels more intentional on every screen.</p>
        </article>
      </div>
    </section>

    <section id="writing" class="section container reveal">
      <div class="section-heading">
        <p class="eyebrow">Writing</p>
        <h2>Short pieces that show how I think about front-end work</h2>
        <p>These short pieces show how I think about interface clarity, mobile behavior, accessibility, and presentation.</p>
      </div>
      <div class="writing-grid">
        {articles.map((article) => (
          <article class="writing-card">
            <p class="writing-type">{article.data.type}</p>
            <h3><a href={`/writing/${article.id}`}>{article.data.title}</a></h3>
            <p>{article.data.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="contact" class="section container reveal">
      <div class="contact-shell">
        <div class="contact-copy">
          <p class="eyebrow">Contact</p>
          <h2>Let's build a page that feels clear, credible, and worth staying on</h2>
          <p>If you have a project, collaboration, internship opportunity, or redesign idea, send a message and I'll get back to you as soon as I can.</p>
          <div class="contact-links">
            <a href="mailto:musabish98@gmail.com">musabish98@gmail.com</a>
            <a href="https://github.com/Zubish" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="https://x.com/goastwriterspen?t=9sXImSmsilFYY_x90LNbrQ&s=09" target="_blank" rel="noopener noreferrer">X</a>
          </div>
        </div>

        <div class="contact-form-card">
          <div id="contact-status" class="contact-status" aria-live="polite"></div>
          <form id="contact-form" novalidate>
            <label for="contact-name">Name</label>
            <input id="contact-name" name="name" type="text" required aria-required="true" autocomplete="name">
            <p class="field-error" id="contact-name-error"></p>

            <label for="contact-email">Email</label>
            <input id="contact-email" name="email" type="email" required aria-required="true" autocomplete="email">
            <p class="field-error" id="contact-email-error"></p>

            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="message" rows="5" required aria-required="true"></textarea>
            <p class="field-error" id="contact-message-error"></p>

            <button type="submit" class="button button-primary">Open email draft</button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
