---
import '../styles/styles.css';

const {
  title = 'Musa Ibrahim | Frontend Developer Intern',
  description = 'Musa Ibrahim is a frontend developer intern and AI-assisted product builder focused on HealthTech, trusted marketplaces, workflow UX, and role-aware web apps.',
  image = '/img/Professional%20photo%20me.jpg',
  htmlClass = '',
  bodyClass = '',
  type = 'website'
} = Astro.props;

const siteUrl = 'https://musa-ibrahim-lac.vercel.app';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
---
<!DOCTYPE html>
<html lang="en" class={htmlClass}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content={description}>
  <meta name="author" content="Musa Ibrahim">
  <meta name="theme-color" content="#0b1220">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content={type}>
  <meta property="og:image" content={imageUrl}>
  <meta property="og:url" content={pageUrl}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={imageUrl}>
  <title>{title}</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%230b1220'/%3E%3Ctext x='50%25' y='54%25' text-anchor='middle' font-family='Arial,sans-serif' font-size='26' fill='%23ffffff'%3EMI%3C/text%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
  <slot name="head" />
</head>
<body class={bodyClass}>
  <slot />
  <div class="image-lightbox" id="image-lightbox" role="dialog" aria-modal="true" aria-label="Expanded project screenshot" hidden>
    <button class="image-lightbox-backdrop" type="button" data-modal-close aria-label="Close expanded screenshot"></button>
    <div class="image-lightbox-panel">
      <button class="image-lightbox-close" type="button" data-modal-close aria-label="Close expanded screenshot">&times;</button>
      <img id="image-lightbox-img" src="" alt="">
    </div>
  </div>
  <script is:inline src="/script.js"></script>
</body>
</html>
